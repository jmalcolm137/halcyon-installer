#!/bin/sh
# Include both possible Broadcom Wi-Fi drivers and the runtime selector.
set -e

. /usr/share/initramfs-tools/hook-functions

copy_exec /usr/lib/halcyon/wifi-select
copy_exec /usr/bin/mkdir

for module in wl brcmfmac brcmutil brcmfmac_wcc; do
    if [ -n "$(find "/lib/modules/${version}" -name "${module}.ko*" -print -quit 2>/dev/null)" ]; then
        manual_add_modules "$module"
    fi
done
