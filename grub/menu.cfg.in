# ensure linux command line is always on a single line; this is because e.g.
# petitboot's grub parser cannot deal with multiline kernel parameters

set pager="1"
set timeout="10"
set default="halcyon-live"

set locale_dir="${prefix}/locale"

# don't actually use gfxterm, as we might be running from serial console
if loadfont unicode; then
    set gfxmode=auto
    insmod all_video
fi

menuentry "@@BOOT_TITLE@@ @@KERNVER@@ (@@ARCH@@)" --id halcyon-live {
    linux /live/@@KERNFILE@@ boot=live live-media=HALCYON_LIVE dinit_skip_volumes init=/usr/bin/init loglevel=4 @@BOOT_CMDLINE@@
    initrd /live/initrd
}

menuentry "@@BOOT_TITLE@@ @@KERNVER@@ (@@ARCH@@) (RAM)" --id halcyon-live-ram {
    linux /live/@@KERNFILE@@ boot=live live-media=HALCYON_LIVE dinit_skip_volumes toram init=/usr/bin/init loglevel=4 @@BOOT_CMDLINE@@
    initrd /live/initrd
}
