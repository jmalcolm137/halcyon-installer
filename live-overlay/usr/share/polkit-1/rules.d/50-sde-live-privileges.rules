// Halcyon live session: the autologin user is a member of wheel. Allow that
// active local user to authenticate through pkexec without relying on a
// desktop PolicyKit agent (the SDE agent is not available in all sessions).
// This makes PartitionEditor and Halcyon Setup work from the live desktop.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
