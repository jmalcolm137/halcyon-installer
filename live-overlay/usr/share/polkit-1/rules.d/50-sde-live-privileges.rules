// Halcyon live session only: the autologin user is a member of wheel. Allow
// that active local user to authenticate through pkexec without relying on a
// desktop PolicyKit agent, which the SDE does not always provide. The
// /run/live check keeps this rule inactive on installed systems.
polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.policykit.exec")
        return;
    var live = polkit.spawn(["/bin/sh", "-c", "test -e /run/live && echo live"]);
    if (live.length > 0 && live[0] == "live" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
