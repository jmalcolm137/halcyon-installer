// Halcyon live session only: the live user is in the dedicated "live" group,
// which only the live image creates. Allow that active local user to use
// pkexec without relying on a desktop PolicyKit agent, which the SDE does not
// always provide.
//
// Do not use polkit.spawn here. polkitd 128 crashes with SIGILL in duktape
// when this rule runs, which made Partition Editor report that authorization
// could not be checked.
polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.policykit.exec")
        return;
    if (subject.local && subject.active && subject.isInGroup("live"))
        return polkit.Result.YES;
});
